*.jsonl
total-jsons/
*.json
*.ipynb_checkpoints
tmp/
__pycache__/

# Carve out: NatErr eval data is the paper's evidence and IS source-tracked.
!data/natErr/*.jsonl
!data/natErr/*.summary.json

# Carve out: X-train/X-dev split + audit manifests are paper-evidence; tracked.
!data/splits/*.json
!data/splits/*.jsonl
!data/splits/*.txt
# Audit reports under subdirs (e.g., p009_smoke/) — small, tracked.
!data/splits/**/p009_*audit*.json
!data/splits/**/*audit*.json

# Claude Code session state: ARIS skills + agent logs. Not part of the paper.
.claude/

# Test / tooling caches
.pytest_cache/
*.egg-info/
.venv/
venv/

# Off-box build artifacts (Fuzzlang-modified Clang)
llvm-project-fuzzlang/
llvm-build/

# NatErr harvest scratch (data, not source-tracked)
scratch/

# Build / harvest run logs
logs/
